DATABASE_URL="mysql://root:password@localhost:3306/stargate_cms"

# Admin CMS login (/admin) — single shared account, no user table.
# Generate a random SESSION_SECRET, e.g.: openssl rand -hex 32
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
SESSION_SECRET="replace-with-a-long-random-string"

# Optional: force the admin session cookie's Secure attribute on/off.
# If unset, defaults to Secure=true whenever NODE_ENV=production (i.e. `npm run start`).
# Set to "false" if you serve /admin over plain HTTP (e.g. a LAN IP like http://192.168.x.x:3010,
# no reverse proxy/TLS) — otherwise browsers on other machines will silently drop the login
# cookie and every admin menu click will bounce back to the login page.
# Set to "true" if you later put this behind a reverse proxy that terminates real HTTPS.
# COOKIE_SECURE=false

# URL prefix the app is served under (default "/web-cdre", matching
# stargate.appinternal.com/web-cdre). Read at build time - rebuild after changing.
# Set to an empty string to serve at the domain root.
# BASE_PATH=""
