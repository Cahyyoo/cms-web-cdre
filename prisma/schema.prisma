// Prisma schema for Stargate Web CMS
// PT Stargate Pasific Resource

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum CategoryType {
  PPM
  CSR
}

enum GalleryType {
  PENGHARGAAN
}

// ---------------------------------------------------------------------------
// A. Beranda — Testimonial Slider
// ---------------------------------------------------------------------------

model Testimonial {
  id          Int      @id @default(autoincrement())
  name        String
  title       String
  quote       String   @db.Text
  imageUrl    String
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("testimonials")
}

// ---------------------------------------------------------------------------
// C. PPM & CSR — Blog / News
// ---------------------------------------------------------------------------

model Category {
  id    Int          @id @default(autoincrement())
  name  String
  type  CategoryType
  order Int          @default(0)
  posts Post[]

  @@unique([name, type])
  @@index([type, order])
  @@map("categories")
}

model Post {
  id           Int       @id @default(autoincrement())
  title        String
  slug         String    @unique
  content      String    @db.Text
  thumbnailUrl String
  categoryId   Int
  category     Category  @relation(fields: [categoryId], references: [id])
  viewCount    Int       @default(0)
  publishedAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([categoryId])
  @@index([viewCount])
  @@index([publishedAt])
  @@map("posts")
}

// ---------------------------------------------------------------------------
// D. Binaan / Katalog UMKM
// ---------------------------------------------------------------------------

model BinaanGroup {
  id       Int       @id @default(autoincrement())
  name     String
  products Product[]

  @@map("binaan_groups")
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  groupId     Int
  group       BinaanGroup @relation(fields: [groupId], references: [id])
  flavor      String?
  description String      @db.Text
  imageUrl    String
  waNumber    String

  @@index([groupId])
  @@map("products")
}

// ---------------------------------------------------------------------------
// E. Penghargaan — Galeri
// ---------------------------------------------------------------------------

model Gallery {
  id       Int         @id @default(autoincrement())
  title    String
  type     GalleryType
  period   String?
  imageUrl String

  @@index([type])
  @@map("galleries")
}

// ---------------------------------------------------------------------------
// F. Galeri Kegiatan — per Kategori (Carousel)
// ---------------------------------------------------------------------------

model ActivityCategory {
  id     Int             @id @default(autoincrement())
  name   String          @unique
  order  Int             @default(0)
  photos ActivityPhoto[]

  @@index([order])
  @@map("activity_categories")
}

model ActivityPhoto {
  id         Int              @id @default(autoincrement())
  caption    String?
  imageUrl   String
  order      Int              @default(0)
  categoryId Int
  category   ActivityCategory @relation(fields: [categoryId], references: [id])
  createdAt  DateTime         @default(now())

  @@index([categoryId])
  @@index([order])
  @@map("activity_photos")
}
